## Interface: 120105, 120100, 120007, 16001, 50504, 20506, 11509
# 16001 = WoW: Forever, 50504 = MoP Classic, 20506 = TBC Anniversary,
# 11509 = Classic Era (also Season of Discovery and Hardcore).
# One manifest for every client, as Auctionator does:
# a separate FarmMap_Camelot.toc would have to repeat the version and the
# file list below, and drift from this one sooner or later.
## Title: FarmMap
## Notes: Records the positions of ores, herbs, fish and wood nodes.
## Notes-frFR: Enregistre la position des minerais, plantes, poissons et bois.
## Notes-zhCN: 记录矿石、草药、鱼和树木节点的位置。
## Author: Kroosstii
## Version: v2.1.2
## X-Date: 19/10/2026
## IconTexture: Interface\AddOns\FarmMap\Textures\icon
## SavedVariables: FarmMapDB FarmMapStatsDB
## OptionalDeps: Auctionator

Libs\HereBeDragons\LibStub\LibStub.lua
Libs\HereBeDragons\CallbackHandler-1.0\CallbackHandler-1.0.lua
Libs\HereBeDragons\HereBeDragons-2.0.lua
Libs\HereBeDragons\HereBeDragons-Pins-2.0.lua

# Minimap button. LibStub and CallbackHandler-1.0 are already loaded
# above (shipped with HereBeDragons). These two libs depend on them,
# so they MUST stay after, otherwise they error out on load.
Libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
Libs\LibDBIcon-1.0\LibDBIcon-1.0.lua

# Translations. enUS MUST stay first: it is the fallback for every
# other language. Adding a language = drop the file in lang\ and add
# its line here. See lang\README.md.
lang\enUS.lua
lang\frFR.lua
lang\koKR.lua
lang\zhCN.lua
lang\ruRU.lua

# Expansion of TBC-MoP gathering items, for the Classic clients (generated
# by tools\make_classic_expansions.py).
data\ClassicItemExpansion.lua

FarmMap.lua

# New options window (v2). After FarmMap.lua: it reads what that file
# shares through the addon namespace.
UI\Theme.lua
UI\OptionsWindow.lua
UI\SessionWindow.lua
# Setup assistant: after OptionsWindow.lua, whose settings it shows.
UI\Setup.lua

# Changelog: one file per version and language, never edited after the
# release (enUS is the fallback). UI\Changelog.lua draws them.
changelog\v2.0.0\enUS.lua
changelog\v2.0.0\frFR.lua
changelog\v2.0.0\zhCN.lua
changelog\v2.0.1\enUS.lua
changelog\v2.0.1\frFR.lua
changelog\v2.1.0\enUS.lua
changelog\v2.1.0\frFR.lua
changelog\v2.1.1\enUS.lua
changelog\v2.1.1\frFR.lua
changelog\v2.1.2\enUS.lua
changelog\v2.1.2\frFR.lua
UI\Changelog.lua
